{
  "apiVersion": "agenleash/v1alpha1",
  "kind": "AdapterSpec",
  "metadata": {
    "name": "opencode_local",
    "displayName": "OpenCode (local)",
    "schemaVersion": 1,
    "adapterRevision": 1
  },
  "spec": {
    "agentFamily": "opencode",
    "detection": {
      "binaryNames": ["opencode"],
      "versionStrategy": {
        "type": "command",
        "command": ["opencode", "--version"],
        "regex": "(?P<version>\\d+\\.\\d+\\.\\d+)",
        "source": "stdout"
      },
      "fallbackProfile": "stable"
    },
    "runtime": {
      "mode": "stdio",
      "entrypoint": "opencode",
      "args": ["run", "--format", "json"],
      "env": {
        "OPENCODE_DISABLE_PROJECT_CONFIG": "true"
      }
    },
    "cwdPolicy": {
      "mode": "required",
      "requireGitRoot": false,
      "resolveSymlink": true
    },
    "capabilities": {
      "requiresTTY": false,
      "supportsResume": true,
      "supportsInterrupt": true,
      "supportsNativeConversationId": true
    },
    "features": {
      "jsonEventStream": true,
      "streamingText": true,
      "toolCallEvents": false,
      "structuredPatch": false,
      "planMode": false
    },
    "conversation": {
      "mode": "native_id",
      "extractors": [
        {
          "type": "regex",
          "source": "stdout",
          "pattern": "\"sessionID\"\\s*:\\s*\"(?P<id>[^\"]+)\""
        }
      ]
    },
    "workspace": {
      "mode": "cwd_plus_git"
    },
    "eventParser": {
      "type": "jsonl_events",
      "profile": "opencode_run"
    },
    "versionProfiles": [
      {
        "name": "stable",
        "match": ">=1.0.0",
        "overrides": {
          "features": {
            "streamingText": true
          }
        }
      }
    ]
  }
}
