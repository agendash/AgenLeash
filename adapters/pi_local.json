{
  "apiVersion": "agenleash/v1alpha1",
  "kind": "AdapterSpec",
  "metadata": {
    "name": "pi_local",
    "displayName": "Pi (local)",
    "schemaVersion": 1,
    "adapterRevision": 1
  },
  "spec": {
    "agentFamily": "pi",
    "detection": {
      "binaryNames": ["pi"],
      "versionStrategy": {
        "type": "command",
        "command": ["pi", "--version"],
        "regex": "(?P<version>\\d+\\.\\d+\\.\\d+)",
        "source": "stdout"
      },
      "fallbackProfile": "stable"
    },
    "runtime": {
      "mode": "stdio_prompt_arg",
      "entrypoint": "pi",
      "args": [
        "--mode",
        "json",
        "-p",
        "--tools",
        "read,bash,edit,write,grep,find,ls",
        "--session",
        "{session}",
        "{prompt}"
      ],
      "env": {}
    },
    "cwdPolicy": {
      "mode": "required",
      "requireGitRoot": false,
      "resolveSymlink": true
    },
    "capabilities": {
      "requiresTTY": false,
      "supportsResume": false,
      "supportsInterrupt": true,
      "supportsNativeConversationId": false
    },
    "features": {
      "jsonEventStream": true,
      "streamingText": true,
      "toolCallEvents": false,
      "structuredPatch": false,
      "planMode": false
    },
    "conversation": {
      "mode": "process_only"
    },
    "workspace": {
      "mode": "cwd_plus_git"
    },
    "eventParser": {
      "type": "jsonl_events",
      "profile": "pi_json"
    },
    "versionProfiles": [
      {
        "name": "stable",
        "match": ">=0.0.0",
        "overrides": {
          "features": {
            "streamingText": true
          }
        }
      }
    ]
  }
}
