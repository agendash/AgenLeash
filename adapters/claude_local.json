{
  "apiVersion": "agenleash/v1alpha1",
  "kind": "AdapterSpec",
  "metadata": {
    "name": "claude_local",
    "displayName": "Claude Code (local)",
    "schemaVersion": 1,
    "adapterRevision": 1
  },
  "spec": {
    "agentFamily": "claudecode",
    "detection": {
      "binaryNames": ["claude", "claudecode"],
      "versionStrategy": {
        "type": "command",
        "command": ["claude", "--version"],
        "regex": "(?P<version>\\d+\\.\\d+\\.\\d+)",
        "source": "stdout"
      },
      "fallbackProfile": "stable"
    },
    "runtime": {
      "mode": "stdio",
      "entrypoint": "claude",
      "args": [
        "--print",
        "-",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "env": {
        "CLAUDE_CODE_HIDE_DEBUG": "1"
      }
    },
    "cwdPolicy": {
      "mode": "required",
      "requireGitRoot": true,
      "resolveSymlink": true
    },
    "capabilities": {
      "requiresTTY": false,
      "supportsResume": true,
      "supportsInterrupt": true,
      "supportsNativeConversationId": true
    },
    "features": {
      "streamingText": true,
      "jsonEventStream": true,
      "fileReferences": true,
      "toolCallEvents": true,
      "structuredPatch": true,
      "planMode": true,
      "x.claudecode.reviewLoop": true
    },
    "conversation": {
      "mode": "native_id"
    },
    "workspace": {
      "mode": "cwd_plus_git"
    },
    "eventParser": {
      "type": "json_events",
      "profile": "stable"
    },
    "versionProfiles": [
      {
        "name": "stable",
        "match": ">=0.1.0",
        "overrides": {
          "features": {
            "streamingText": true
          }
        }
      }
    ]
  }
}
