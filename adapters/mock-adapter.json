{
  "apiVersion": "agenleash/v1alpha1",
  "kind": "AdapterSpec",
  "metadata": {
    "name": "mock-adapter",
    "displayName": "Mock Adapter",
    "schemaVersion": 1,
    "adapterRevision": 1
  },
  "spec": {
    "agentFamily": "mockagent",
    "detection": {
      "binaryNames": ["mockagent"],
      "versionStrategy": {
        "type": "command",
        "command": ["mockagent", "--version"],
        "regex": "(?P<version>\\d+\\.\\d+\\.\\d+)",
        "source": "stdout"
      },
      "fallbackProfile": "legacy"
    },
    "runtime": {
      "mode": "stdio",
      "entrypoint": "mockagent",
      "args": ["--serve"],
      "env": {
        "MOCK_AGENT_TRACE": "1"
      }
    },
    "cwdPolicy": {
      "mode": "optional",
      "requireGitRoot": false,
      "resolveSymlink": true
    },
    "capabilities": {
      "requiresTTY": false,
      "supportsResume": false,
      "supportsInterrupt": true,
      "supportsNativeConversationId": false
    },
    "features": {
      "streamingText": true,
      "jsonEventStream": true,
      "toolCallEvents": false,
      "structuredPatch": false
    },
    "conversation": {
      "mode": "process_only",
      "extractors": [
        {
          "type": "regex",
          "source": "stdout",
          "pattern": "Conversation ID: (?P<id>[A-Za-z0-9_-]+)"
        }
      ]
    },
    "workspace": {
      "mode": "cwd_only"
    },
    "eventParser": {
      "type": "json_events",
      "profile": "default"
    },
    "versionProfiles": [
      {
        "name": "legacy",
        "match": "<1.0.0",
        "overrides": {
          "features": {
            "toolCallEvents": false,
            "structuredPatch": false
          },
          "conversation": {
            "mode": "process_only"
          },
          "eventParser": {
            "type": "ansi_rules",
            "profile": "legacy_compat"
          }
        }
      },
      {
        "name": "stable",
        "match": ">=1.0.0",
        "overrides": {
          "capabilities": {
            "supportsResume": true,
            "supportsNativeConversationId": true
          },
          "features": {
            "toolCallEvents": true,
            "structuredPatch": true,
            "planMode": true
          },
          "conversation": {
            "mode": "native_id"
          },
          "workspace": {
            "mode": "cwd_plus_git"
          },
          "eventParser": {
            "type": "json_events",
            "profile": "stable"
          }
        }
      }
    ]
  }
}
