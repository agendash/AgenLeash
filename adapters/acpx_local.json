{
  "apiVersion": "agenleash/v1alpha1",
  "kind": "AdapterSpec",
  "metadata": {
    "name": "acpx_local",
    "displayName": "ACPX (local)",
    "schemaVersion": 1,
    "adapterRevision": 1
  },
  "spec": {
    "agentFamily": "acpx",
    "detection": {
      "binaryNames": ["acpx"],
      "versionStrategy": {
        "type": "command",
        "command": ["acpx", "--version"],
        "regex": "(?P<version>\\d+\\.\\d+\\.\\d+)",
        "source": "stdout"
      },
      "fallbackProfile": "stable"
    },
    "runtime": {
      "mode": "stdio",
      "entrypoint": "acpx",
      "args": [
        "--format",
        "json",
        "--json-strict",
        "--approve-all",
        "--non-interactive-permissions",
        "deny",
        "--cwd",
        "{cwd}",
        "claude"
      ],
      "env": {}
    },
    "cwdPolicy": {
      "mode": "required",
      "requireGitRoot": false,
      "resolveSymlink": true
    },
    "capabilities": {
      "requiresTTY": false,
      "supportsResume": true,
      "supportsInterrupt": true,
      "supportsNativeConversationId": true
    },
    "features": {
      "jsonEventStream": true,
      "streamingText": true,
      "toolCallEvents": true,
      "structuredPatch": false,
      "planMode": false
    },
    "conversation": {
      "mode": "native_id"
    },
    "workspace": {
      "mode": "cwd_plus_git"
    },
    "eventParser": {
      "type": "jsonl_events",
      "profile": "acpx_json"
    },
    "versionProfiles": [
      {
        "name": "stable",
        "match": ">=0.0.0",
        "overrides": {
          "features": {
            "streamingText": true
          }
        }
      }
    ]
  }
}
