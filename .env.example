# Required for any non-local deployment.
# Generate one with `uuidgen` if you do not already have a token.
AGENLEASH_TOKEN=replace-with-a-uuid-or-other-random-token

# Host port for docker compose. Use a non-conflicting port when 8081 is already
# occupied by AgenDash or another local service.
AGENLEASH_PORT=8081

# Listen address for the HTTP + WebSocket gateway.
AGENLEASH_ADDR=0.0.0.0:8081

# Browser dashboard is disabled by default. Set to true to enable /stats.
# AGENLEASH_ENABLE_WEB=true

# AgenLeash runtime data.
AGENLEASH_DATA_DIR=./tmp/agenleash

# Built-in history discovery.
AGENLEASH_DISCOVER_CLAUDE=true
AGENLEASH_DISCOVER_CODEX=true
AGENLEASH_DISCOVER_OPENCODE=true
AGENLEASH_CLAUDE_HOME=/home/you/.claude
AGENLEASH_CODEX_HOME=/home/you/.codex
AGENLEASH_OPENCODE_HOME=/home/you/.local/share/opencode

# Restrict managed sessions to trusted workspace roots.
AGENLEASH_ALLOWED_WORKSPACE_ROOTS=/workspaces,/srv/repos

# Optional tuning.
AGENLEASH_HISTORY_REFRESH_INTERVAL=30s
AGENLEASH_SESSION_PERSIST_INTERVAL=2s

# Docker-only host bind mount helpers used by compose.yaml.
AGENLEASH_CLAUDE_HOST_DIR=/home/you/.claude
AGENLEASH_CODEX_HOST_DIR=/home/you/.codex
AGENLEASH_OPENCODE_HOST_DIR=/home/you/.local/share/opencode
AGENLEASH_WORKSPACE_HOST_DIR=/home/you/Workspace
AGENLEASH_AGENT_BIN_HOST_DIR=./agent-bin

# Development only. Leave commented in production.
# AGENLEASH_ALLOW_NO_TOKEN=true
